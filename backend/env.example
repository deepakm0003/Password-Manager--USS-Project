NODE_ENV=development
PORT=5000

# Database & cache
DATABASE_URL=postgresql://admin:securepass@localhost:5432/unified_auth?schema=public
REDIS_URL=redis://localhost:6379

# JWT & crypto
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
replace-with-base64-or-pem
-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----
replace-with-public-key
-----END PUBLIC KEY-----
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ENCRYPTION_KEY=replace-with-64-hex

# Relay & email
RELAY_DOMAIN=relay.uam.local
RELAY_WEBHOOK_SECRET=replace-with-64-hex
RELAY_ENCRYPTION_KEY=replace-with-64-hex
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=relay@example.com
SMTP_PASSWORD=super-secure-password

# Push & observability
FCM_SERVER_KEY=replace-with-server-key
FCM_SERVICE_ACCOUNT=base64-encoded-service-account-json
SENTRY_DSN=https://example.ingest.sentry.io/123

# Optional CORS overrides (comma-separated)
CORS_ORIGIN=http://localhost:19006,http://localhost:5000

