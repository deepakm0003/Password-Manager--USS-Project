{
  "name": "unified-auth-manager-backend",
  "version": "1.0.0",
  "description": "Backend API for Unified Authentication Manager",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/workers/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/workers/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --swc prisma/seed.ts",
    "test:db": "node test-db-connection.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "@sentry/node": "^10.25.0",
    "@types/validator": "^13.15.9",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.63.2",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^12.7.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3",
    "nodemailer": "^6.9.7",
    "pino": "^9.2.0",
    "prisma": "^5.7.1",
    "prom-client": "^15.1.3",
    "redis": "^4.6.12",
    "tweetnacl": "^1.0.3",
    "uuid": "^9.0.1",
    "validator": "^13.15.23",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^6.4.14",
    "@types/uuid": "^9.0.7",
    "pino-pretty": "^11.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "authentication",
    "password-manager",
    "mfa",
    "email-relay"
  ],
  "author": "",
  "license": "ISC"
}
