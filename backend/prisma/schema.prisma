// Prisma Schema for Unified Authentication Manager
// Database: PostgreSQL
// This schema matches all data structures used in the mobile app

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MFAStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

enum AliasStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum AliasRoutingMode {
  DIRECT
  HMAC_LOOKUP
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  accountPasswordHash String?
  masterKeySalt       String
  kdfIterations       Int       @default(200000)
  masterKeyParams     Json
  status              String    @default("active")
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  devices       Device[]
  vaultEntries  VaultEntry[]
  mfaRequests   MfaRequest[]
  aliases       Alias[]
  authSessions  AuthSession[]
  auditLogs     AuditLog[]
  vaultMetadata VaultMetadata?

  @@index([status])
  @@map("users")
}

model Device {
  id             String    @id @default(uuid())
  userId         String
  name           String
  publicKey      String // Ed25519 / secp256k1 public key
  keyAlgorithm   String    @default("ed25519")
  fcmTokenCipher String? // encrypted FCM token
  platform       String
  appVersion     String?
  isPrimary      Boolean   @default(false)
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime?

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    AuthSession[]
  mfaRequests MfaRequest[]

  @@index([userId])
  @@index([revokedAt])
  @@map("devices")
}

model VaultEntry {
  id         String   @id @default(uuid())
  userId     String
  ciphertext String // AES-256-GCM blob (base64)
  nonce      String
  authTag    String?
  metadata   Json     @db.JsonB
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("vault_entries")
}

model MfaRequest {
  id         String    @id @default(uuid())
  userId     String
  deviceId   String?
  challenge  String
  payload    Json      @db.JsonB
  status     MFAStatus @default(PENDING)
  signature  String?
  approvedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@index([deviceId])
  @@index([status])
  @@index([expiresAt])
  @@map("mfa_requests")
}

model Alias {
  id               String           @id @default(uuid())
  userId           String
  aliasEmail       String           @unique
  routingMode      AliasRoutingMode @default(DIRECT)
  targetCiphertext String?
  targetHmac       String?
  hmacKeyVersion   Int?             @default(1)
  status           AliasStatus      @default(ACTIVE)
  autoExpire       Boolean          @default(false)
  useCount         Int              @default(0)
  lastUsedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("aliases")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  deviceId         String?
  accessTokenJti   String    @unique
  refreshTokenHash String    @unique
  refreshExpiresAt DateTime
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  revokedAt        DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@index([deviceId])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  meta      Json?    @db.JsonB
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model VaultMetadata {
  id            String   @id @default(uuid())
  userId        String   @unique
  version       String   @default("1.0.0")
  kdfAlgorithm  String   @default("PBKDF2")
  kdfSalt       String
  kdfIterations Int      @default(200000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vault_metadata")
}
