{
  "name": "unified-auth-manager",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan --clear",
    "start:tunnel": "expo start --tunnel --clear",
